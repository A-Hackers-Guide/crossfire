{
  "name": "crossfire-electron",
  "productName": "Crossfire",
  "version": "0.1.0",
  "description": "Crossfire (Electron fallback shell) - port any project between Windows, macOS, Linux and FreeBSD",
  "main": "main.cjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "engine": "cargo build --release --manifest-path ../../engine/Cargo.toml",
    "ui": "npm --prefix ../../ui run build",
    "start": "npm run ui && npm run engine && electron .",
    "dist": "npm run ui && npm run engine && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.crossfire.electron",
    "productName": "Crossfire",
    "files": [
      "main.cjs",
      "preload.cjs",
      {
        "from": "../../ui/dist",
        "to": "ui"
      }
    ],
    "extraResources": [
      {
        "from": "../../engine/target/release",
        "to": "bin",
        "filter": [
          "crossfire-engine",
          "crossfire-engine.exe"
        ]
      }
    ],
    "icon": "../../assets/icon.png",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "A-Hackers-Guide <289517818+A-Hackers-Guide@users.noreply.github.com>"
    }
  },
  "homepage": "https://github.com/A-Hackers-Guide/crossfire",
  "author": {
    "name": "A-Hackers-Guide",
    "email": "289517818+A-Hackers-Guide@users.noreply.github.com"
  }
}
